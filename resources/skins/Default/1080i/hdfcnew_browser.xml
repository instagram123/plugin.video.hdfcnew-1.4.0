                        </control>
                        <control type="group">
                            <left>31</left><top>24</top>
                            <visible>!String.IsEmpty(ListItem.Property(badge))</visible>
                            <control type="image">
                                <left>0</left><top>0</top><width>124</width><height>26</height>
                                <texture border="10" colordiffuse="FFE50914">hdfcnew_rounded.png</texture>
                                <visible>Control.HasFocus(500)</visible>
                            </control>
                            <control type="image">
                                <left>0</left><top>0</top><width>124</width><height>26</height>
                                <texture border="10" colordiffuse="D9000000">hdfcnew_rounded.png</texture>
                                <visible>!Control.HasFocus(500)</visible>
                            </control>
                            <control type="label">
                                <left>0</left><top>0</top><width>124</width><height>26</height>
                                <font>font10</font><align>center</align><aligny>center</aligny>
                                <textcolor>FFFFFFFF</textcolor>
                                <label>$INFO[ListItem.Property(badge)]</label>
