                    <control type="image">
                        <left>0</left><top>4</top><width>348</width><height>44</height>
                        <texture border="16" colordiffuse="2EE50914">hdfcnew_rounded.png</texture>
                        <visible>String.IsEqual(ListItem.Property(active),true)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>12</top><width>5</width><height>28</height>
                        <texture colordiffuse="FFE50914">hdfcnew_white.png</texture>
                        <visible>String.IsEqual(ListItem.Property(active),true)</visible>
                    </control>
                    <!-- group header -->
                    <control type="label">
                        <left>18</left><top>0</top><width>280</width><height>52</height>
                        <font>font10</font>
                        <aligny>center</aligny>
                        <textcolor>FF6C7385</textcolor>
                        <label>[UPPERCASE]$INFO[ListItem.Label][/UPPERCASE]</label>
                        <visible>String.IsEqual(ListItem.Property(header),true)</visible>
                    </control>
                    <control type="label">
                        <left>290</left><top>0</top><width>40</width><height>52</height>
                        <font>font13</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>FF6C7385</textcolor>
                        <label>$INFO[ListItem.Property(arrow)]</label>
                        <visible>String.IsEqual(ListItem.Property(header),true)</visible>
                    </control>
                    <!-- entry (child entries are indented) -->
                    <control type="label">
                        <left>24</left><top>0</top><width>310</width><height>52</height>
                        <font>font13</font>
                        <aligny>center</aligny>
                        <textcolor>FFA9AFBD</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(ListItem.Property(header),true) + !String.IsEqual(ListItem.Property(child),true) + !String.IsEqual(ListItem.Property(active),true)</visible>
                    </control>
                    <control type="label">
                        <left>24</left><top>0</top><width>310</width><height>52</height>
                        <font>font13</font>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(ListItem.Property(header),true) + !String.IsEqual(ListItem.Property(child),true) + String.IsEqual(ListItem.Property(active),true)</visible>
                    </control>
                    <control type="label">
                        <left>42</left><top>0</top><width>292</width><height>52</height>
                        <font>font12</font>
                        <aligny>center</aligny>
                        <textcolor>FF9AA0AE</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(child),true) + !String.IsEqual(ListItem.Property(active),true)</visible>
                    </control>
                    <control type="label">
                        <left>42</left><top>0</top><width>292</width><height>52</height>
                        <font>font12</font>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(child),true) + String.IsEqual(ListItem.Property(active),true)</visible>
                    </control>
                </itemlayout>
                <focusedlayout width="348" height="52">
                    <control type="image">
                        <left>0</left><top>4</top><width>348</width><height>44</height>
                        <texture border="16" colordiffuse="2EE50914">hdfcnew_rounded.png</texture>
                        <visible>String.IsEqual(ListItem.Property(active),true) + !Control.HasFocus(300)</visible>
                    </control>
                    <control type="image">
                        <left>0</left><top>4</top><width>348</width><height>44</height>
                        <texture border="16" colordiffuse="FF2A303E">hdfcnew_rounded.png</texture>
                        <visible>Control.HasFocus(300)</visible>
                        <animation effect="fade" start="0" end="100" time="150">Visible</animation>
                    </control>
                    <control type="image">
                        <left>0</left><top>12</top><width>5</width><height>28</height>
                        <texture colordiffuse="FFE50914">hdfcnew_white.png</texture>
                        <visible>String.IsEqual(ListItem.Property(active),true) | Control.HasFocus(300)</visible>
                    </control>
                    <control type="label">
                        <left>18</left><top>0</top><width>280</width><height>52</height>
                        <font>font10</font>
                        <aligny>center</aligny>
                        <textcolor>FFC8CCD6</textcolor>
                        <label>[UPPERCASE]$INFO[ListItem.Label][/UPPERCASE]</label>
                        <visible>String.IsEqual(ListItem.Property(header),true)</visible>
                    </control>
                    <control type="label">
                        <left>290</left><top>0</top><width>40</width><height>52</height>
                        <font>font13</font>
                        <align>center</align>
                        <aligny>center</aligny>
                        <textcolor>FFC8CCD6</textcolor>
                        <label>$INFO[ListItem.Property(arrow)]</label>
                        <visible>String.IsEqual(ListItem.Property(header),true)</visible>
                    </control>
                    <control type="label">
                        <left>24</left><top>0</top><width>310</width><height>52</height>
                        <font>font13</font>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(ListItem.Property(header),true) + !String.IsEqual(ListItem.Property(child),true)</visible>
                    </control>
                    <control type="label">
                        <left>42</left><top>0</top><width>292</width><height>52</height>
                        <font>font12</font>
                        <aligny>center</aligny>
                        <textcolor>FFFFFFFF</textcolor>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(child),true)</visible>
                    </control>
                </focusedlayout>
            </control>

            <!-- settings -->
