                <control type="label">
                    <left>1300</left><top>36</top><width>580</width><height>40</height>
                    <font>font13</font>
                    <align>right</align>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[Container(500).ListItem.Property(fulltitle)]</label>
                </control>
                <control type="label">
                    <left>1300</left><top>78</top><width>580</width><height>32</height>
                    <font>font12</font>
                    <align>right</align>
                    <textcolor>FFF5A623</textcolor>
                    <label>$INFO[Container(500).ListItem.Property(meta)]</label>
                </control>
            </control>

            <!-- ================= poster grid ================= -->
            <control type="panel" id="500">
                <left>420</left><top>136</top><width>1476</width><height>840</height>
                <onleft>300</onleft>
                <ondown>600</ondown>
                <onup>200</onup>
                <orientation>vertical</orientation>
                <scrolltime tween="cubic" easing="out">250</scrolltime>
                <preloaditems>2</preloaditems>
                <itemlayout width="246" height="420">
                    <control type="image">
                        <left>23</left><top>16</top><width>200</width><height>300</height>
                        <texture diffuse="hdfcnew_mask.png" colordiffuse="FFA8A8A8">hdfcnew_placeholder.png</texture>
                    </control>
                    <control type="image">
                        <left>23</left><top>16</top><width>200</width><height>300</height>
                        <aspectratio>scale</aspectratio>
                        <fadetime>200</fadetime>
                        <texture background="true" diffuse="hdfcnew_mask.png" colordiffuse="FFA8A8A8" fallback="hdfcnew_placeholder.png">$INFO[ListItem.Art(poster)]</texture>
                    </control>
                    <!-- badges -->
                    <control type="group">
                        <left>31</left><top>24</top>
                        <visible>!String.IsEmpty(ListItem.Property(badge))</visible>
                        <control type="image">
                            <left>0</left><top>0</top><width>124</width><height>26</height>
                            <texture border="10" colordiffuse="D9000000">hdfcnew_rounded.png</texture>
                        </control>
                        <control type="label">
                            <left>0</left><top>0</top><width>124</width><height>26</height>
                            <font>font10</font><align>center</align><aligny>center</aligny>
                            <textcolor>FFE6E8EE</textcolor>
                            <label>$INFO[ListItem.Property(badge)]</label>
                        </control>
                    </control>
                    <control type="group">
                        <left>161</left><top>24</top>
