<?xml version="1.0" encoding="UTF-8"?>
<!--
    plugin.video.hdfcnew - full-screen browser (opened by resources/lib/gui.py)
    Colors: background FF0B0D12, sidebar E6141821, accent FFE50914 (red), muted text FF8A90A0.
    Control ids: 200 search, 210 settings, 300 categories, 500 poster grid, 600 bottom buttons (601 prev, 602 next).
    Window properties set from Python: view_title, view_subtitle, page_label, has_prev, has_next,
    loading, empty, search_active, addon_name.
    Details view (same window, shown instead of the browser while details_open is set):
    control ids 700 buttons (701 Play / Episodes, 702 Trailer, 703 Back), 710 plot scrollbar;
    properties details_open, d_title, d_original, d_poster, d_backdrop, d_meta, d_plot, d_director,
    d_cast, d_sources, d_trailer, d_main_label, d_loading.
-->
<window>
    <defaultcontrol always="false">300</defaultcontrol>
    <backgroundcolor>FF0B0D12</backgroundcolor>
    <animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>
        <!-- ================= background + dimmed backdrop of the focused poster ================= -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0B0D12">hdfcnew_white.png</texture>
        </control>
        <!-- ================= browser: hidden while the details view is open ================= -->
        <control type="group">
            <visible>String.IsEmpty(Window.Property(details_open))</visible>
            <animation effect="fade" start="0" end="100" time="200">VisibleChange</animation>
            <control type="image">
                <left>380</left><top>0</top><width>1540</width><height>1080</height>
                <aspectratio>scale</aspectratio>
                <fadetime>500</fadetime>
                <texture background="true" colordiffuse="40FFFFFF">$INFO[Container(500).ListItem.Art(poster)]</texture>
                <visible>!String.IsEmpty(Container(500).ListItem.Art(poster))</visible>
            </control>
            <control type="image">
                <left>380</left><top>0</top><width>1540</width><height>1080</height>
                <texture colordiffuse="C00B0D12">hdfcnew_white.png</texture>
            </control>
            <control type="image">
                <left>380</left><top>0</top><width>900</width><height>1080</height>
                <texture colordiffuse="E6FFFFFF">hdfcnew_gradient_h.png</texture>
            </control>
            <control type="image">
                <left>380</left><top>640</top><width>1540</width><height>440</height>
                <texture colordiffuse="FFFFFFFF">hdfcnew_gradient_v.png</texture>
            </control>

            <!-- ================= sidebar ================= -->
            <control type="image">
                <left>0</left><top>0</top><width>380</width><height>1080</height>
                <texture colordiffuse="E6141821">hdfcnew_white.png</texture>
            </control>
            <control type="image">
                <left>379</left><top>0</top><width>1</width><height>1080</height>
                <texture colordiffuse="FF232836">hdfcnew_white.png</texture>
            </control>
            <control type="image">
                <left>28</left><top>30</top><width>68</width><height>68</height>
                <aspectratio>keep</aspectratio>
                <texture diffuse="hdfcnew_rounded.png">hdfcnew_logo.png</texture>
            </control>
            <control type="label">
                <left>110</left><top>34</top><width>256</width><height>34</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(addon_name)]</label>
            </control>
            <control type="label">
                <left>110</left><top>66</top><width>256</width><height>28</height>
                <font>font10</font>
                <textcolor>FF8A90A0</textcolor>
                <label>hdfilmcehennemi.nl</label>
            </control>

            <!-- search -->
            <control type="image">
                <left>8</left><top>136</top><width>5</width><height>36</height>
                <texture colordiffuse="FFE50914">hdfcnew_white.png</texture>
                <visible>String.IsEqual(Window.Property(search_active),true)</visible>
            </control>
            <control type="button" id="200">
                <left>24</left><top>124</top><width>332</width><height>60</height>
                <label>$ADDON[plugin.video.hdfcnew 30010]</label>
                <font>font13</font>
                <textcolor>FFC8CCD6</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <textoffsetx>62</textoffsetx>
                <aligny>center</aligny>
                <texturefocus border="16" colordiffuse="FFE50914">hdfcnew_rounded.png</texturefocus>
                <texturenofocus border="16" colordiffuse="FF1E2330">hdfcnew_rounded.png</texturenofocus>
                <onup>210</onup>
                <ondown>300</ondown>
                <onright>500</onright>
            </control>
            <control type="image">
                <left>44</left><top>140</top><width>28</width><height>28</height>
                <aspectratio>keep</aspectratio>
                <texture colordiffuse="FFC8CCD6">DefaultAddonsSearch.png</texture>
            </control>

            <!-- categories -->
            <control type="list" id="300">
                <left>16</left><top>204</top><width>348</width><height>776</height>
                <onup>200</onup>
                <ondown>210</ondown>
                <onright>500</onright>
                <orientation>vertical</orientation>
                <scrolltime tween="cubic" easing="out">200</scrolltime>
                <itemlayout width="348" height="52">
