                            <left>0</left><top>0</top><width>54</width><height>26</height>
                            <texture border="10" colordiffuse="E6F5A623">hdfcnew_rounded.png</texture>
                        </control>
                        <control type="label">
                            <left>0</left><top>0</top><width>54</width><height>26</height>
                            <font>font10</font><align>center</align><aligny>center</aligny>
                            <textcolor>FF111111</textcolor>
                            <label>$INFO[ListItem.Property(rating)]</label>
                        </control>
                    </control>
                    <control type="group">
                        <left>31</left><top>282</top>
                        <visible>!String.IsEmpty(ListItem.Property(year))</visible>
                        <control type="image">
                            <left>0</left><top>0</top><width>64</width><height>26</height>
                            <texture border="10" colordiffuse="D9000000">hdfcnew_rounded.png</texture>
                        </control>
                        <control type="label">
                            <left>0</left><top>0</top><width>64</width><height>26</height>
                            <font>font10</font><align>center</align><aligny>center</aligny>
                            <textcolor>FFE6E8EE</textcolor>
                            <label>$INFO[ListItem.Property(year)]</label>
                        </control>
                    </control>
                    <control type="label">
                        <left>13</left><top>326</top><width>220</width><height>68</height>
                        <font>font12</font>
                        <align>center</align>
                        <wrapmultiline>true</wrapmultiline>
                        <textcolor>FF8A90A0</textcolor>
                        <label>$INFO[ListItem.Property(shorttitle)]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="246" height="420">
                    <control type="group">
                        <left>0</left><top>0</top><width>246</width><height>332</height>
                        <animation effect="zoom" start="100" end="108" center="auto" time="200" tween="sine" easing="out" condition="Control.HasFocus(500)">Conditional</animation>
                        <control type="image">
                            <left>-1</left><top>-8</top><width>248</width><height>348</height>
